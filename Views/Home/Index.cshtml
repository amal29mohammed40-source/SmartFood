@model dynamic
@{
    ViewData["Title"] = "Home Page";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SmartFood</title>
    <script src="https://cdn.jsdelivr.net/npm/@@tailwindcss/browser@@4"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>
<body class="bg-gray-50 text-gray-800 font-sans antialiased">

    <header class="bg-white shadow-sm sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <div class="flex items-center gap-2">
                <div class="bg-emerald-600 text-white p-2 rounded-xl shadow-md shadow-emerald-200">
                    <i class="fa-solid fa-utensils text-xl"></i>
                </div>
                <span class="text-2xl font-black text-gray-900 tracking-tight">Smart<span class="text-emerald-600">Food</span></span>
            </div>

            <nav class="hidden md:flex items-center gap-8 font-medium text-gray-600">
                <a asp-controller="Home" asp-action="Index" class="text-emerald-600 font-semibold hover:text-emerald-700 transition">Home</a>
                <a asp-controller="Recipes" asp-action="Index" class="hover:text-emerald-600 transition">Recipes</a>
                <a asp-controller="Ai" asp-action="Index" class="hover:text-emerald-600 transition">AI Suggestions</a>
                <a asp-controller="Favorites" asp-action="Index" class="hover:text-emerald-600 transition">Favorites</a>
                <a asp-controller="MealPlanner" asp-action="Index" class="hover:text-emerald-600 transition">Planner</a>
            </nav>
            
            <div class="hidden md:block w-32"></div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24 grid md:grid-cols-2 gap-12 items-center">
        <div class="space-y-8 text-center md:text-left">
            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-gray-900 leading-tight">
                Eat <span class="text-emerald-600 underline decoration-wavy decoration-emerald-200">smarter</span>.<br />
                Live healthier.
            </h1>
            
            <p class="text-lg text-gray-600 max-w-xl mx-auto md:mx-0 leading-relaxed">
                Discover healthy recipes, get AI suggestions based on your weight goal, calories, and ingredients, then plan your meals easily.
            </p>

            <div class="flex flex-col sm:flex-row items-center justify-center md:justify-start gap-4 pt-2">
                <a asp-controller="Recipes" asp-action="Index" class="w-full sm:w-auto px-8 py-4 bg-emerald-600 hover:bg-emerald-700 text-white font-medium rounded-2xl shadow-xl shadow-emerald-200 flex items-center justify-center gap-3 transition transform hover:-translate-y-0.5">
                    <i class="fa-solid fa-magnifying-glass"></i> Browse Recipes
                </a>
            </div>
        </div>

        <div class="relative group">
            <div class="absolute -inset-1 bg-gradient-to-r from-emerald-500 to-teal-500 rounded-3xl blur opacity-25 group-hover:opacity-40 transition duration-1000"></div>
            <div class="relative bg-white p-2 rounded-3xl shadow-2xl">
                <img src="https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&fit=crop&w=1200&q=80" 
                     alt="Healthy Aesthetic Food Table" 
                     class="w-full h-[450px] object-cover rounded-2xl" />
            </div>
        </div>
    </main>

</body>
</html>