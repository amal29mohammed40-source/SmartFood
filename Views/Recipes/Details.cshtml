@model SmartFood.Models.Recipe
@{
    ViewData["Title"] = Model.Title;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script src="https://cdn.jsdelivr.net/npm/@@tailwindcss/browser@@4"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>
<body class="bg-gray-50 text-gray-800 font-sans antialiased">

    <div class="max-w-4xl mx-auto px-4 py-12">
        <button onclick="history.back()" class="inline-flex items-center gap-2 text-sm font-semibold text-gray-500 hover:text-emerald-600 transition mb-6 cursor-pointer">
            <i class="fa-solid fa-arrow-left"></i> Back to Previous Page
        </button>

        <div class="bg-white rounded-3xl shadow-sm border border-gray-100 overflow-hidden">
            
            <div class="relative h-72 md:h-96 w-full bg-gray-100">
                <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "https://images.unsplash.com/photo-1498837167922-ddd27525d352" : Model.ImageUrl)" 
                     alt="@Model.Title" class="w-full h-full object-cover" />
                <div class="absolute top-4 right-4 bg-gray-950/70 backdrop-blur-md text-white text-xs font-bold px-3 py-1.5 rounded-full flex items-center gap-1.5">
                    <i class="fa-solid fa-fire text-amber-400"></i> @Model.Calories kcal
                </div>
            </div>

            <div class="p-6 md:p-10 space-y-8">
                
                <div>
                    <h1 class="text-3xl font-black text-gray-950 tracking-tight">@Model.Title</h1>
                    <p class="text-gray-500 mt-2 text-base leading-relaxed">@Model.Description</p>
                </div>

                <div class="grid grid-cols-3 gap-4 p-4 bg-emerald-50/50 rounded-2xl border border-emerald-100/50 text-center">
                    <div>
                        <span class="block text-[10px] uppercase font-bold text-gray-400 tracking-wider">Protein</span>
                        <span class="text-lg font-black text-emerald-800">@(Model.Protein)g</span>
                    </div>
                    <div>
                        <span class="block text-[10px] uppercase font-bold text-gray-400 tracking-wider">Carbs</span>
                        <span class="text-lg font-black text-emerald-800">@(Model.Carbs)g</span>
                    </div>
                    <div>
                        <span class="block text-[10px] uppercase font-bold text-gray-400 tracking-wider">Fat</span>
                        <span class="text-lg font-black text-emerald-800">@(Model.Fat)g</span>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-8 pt-4 border-t border-gray-100">
                    <div class="space-y-4">
                        <h3 class="text-lg font-bold text-gray-900 flex items-center gap-2">
                            <i class="fa-solid fa-basket-shopping text-emerald-600 text-sm"></i> Ingredients
                        </h3>
                        <p class="text-sm text-gray-600 leading-relaxed whitespace-pre-line">
                            @(string.IsNullOrEmpty(Model.Ingredients) ? "Standard whole food healthy ingredients included." : Model.Ingredients)
                        </p>
                    </div>

                    <div class="space-y-4">
                        <h3 class="text-lg font-bold text-gray-900 flex items-center gap-2">
                            <i class="fa-solid fa-kitchen-set text-emerald-600 text-sm"></i> Preparation Steps
                        </h3>
                        <p class="text-sm text-gray-600 leading-relaxed">
                            Mix all fresh ingredients according to standard healthy diet procedures, balance macros to align with your health targets, and serve fresh.
                        </p>
                    </div>
                </div>

            </div>
        </div>
    </div>

</body>
</html>