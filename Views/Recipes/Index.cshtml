@model IEnumerable<SmartFood.Models.Recipe>
@{
    ViewData["Title"] = "Healthy Recipes Exploration";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script src="https://cdn.jsdelivr.net/npm/@@tailwindcss/browser@@4"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>
<body class="bg-gray-50 text-gray-800 font-sans antialiased">

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        
        <div class="border-b border-gray-200 pb-6 mb-10">
            <h1 class="text-3xl font-black text-gray-950 tracking-tight flex items-center gap-3">
                <i class="fa-solid fa-utensils text-emerald-600"></i> Explore Healthy Recipes
            </h1>
            <p class="text-sm text-gray-500 mt-1">Discover highly nutritious dishes, structured macronutrients, and choose your fuels carefully.</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
            @if (Model != null && Model.Any())
            {
                @foreach (var recipe in Model)
                {
                    <div class="bg-white rounded-3xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-md transition flex flex-col justify-between">
                        <div>
                            <div class="relative h-48 w-full bg-gray-50">
                                <img src="@(string.IsNullOrEmpty(recipe.ImageUrl) ? "https://images.unsplash.com/photo-1498837167922-ddd27525d352" : recipe.ImageUrl)" 
                                     alt="@recipe.Title" class="w-full h-full object-cover" />
                                <div class="absolute top-3 right-3 bg-gray-950/70 backdrop-blur-md text-white text-[11px] font-bold px-2.5 py-1 rounded-full flex items-center gap-1">
                                    <i class="fa-solid fa-fire text-amber-400"></i> @recipe.Calories kcal
                                </div>
                            </div>

                            <div class="p-5 space-y-3">
                                <h2 class="text-lg font-bold text-gray-950 line-clamp-1">@recipe.Title</h2>
                                <p class="text-xs text-gray-400 line-clamp-2">@recipe.Description</p>
                                
                                <div class="flex items-center gap-3 text-[11px] font-bold text-emerald-800 bg-emerald-50/50 p-2 rounded-xl border border-emerald-100/30">
                                    <span>🥩 P: @(recipe.Protein)g</span>
                                    <span>🌿 C: @(recipe.Carbs)g</span>
                                    <span>🥑 F: @(recipe.Fat)g</span>
                                </div>
                            </div>
                        </div>

                        <div class="p-5 pt-0">
                            <a href="/Recipes/Details/@recipe.Id" class="block w-full text-center py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold rounded-xl shadow-md shadow-emerald-50 transition">
                                View Full Recipe
                            </a>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-span-full text-center py-16 bg-white border border-dashed border-gray-200 rounded-3xl p-8">
                    <i class="fa-solid fa-cookie-bite text-gray-300 text-4xl mb-3"></i>
                    <p class="text-sm font-semibold text-gray-500">No recipes available in the platform database right now.</p>
                </div>
            }
        </div>

    </div>

</body>
</html>